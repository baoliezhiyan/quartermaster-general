# Stable text bytes across Windows/Linux; native launchers retain CRLF.
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.ps1 text eol=lf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.webp binary
*.docx binary
*.xlsx binary
